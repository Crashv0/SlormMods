#include <winver.h>
#include "source/Version.hpp"

VS_VERSION_INFO VERSIONINFO
FILEVERSION SLORMCORE_MAJOR, SLORMCORE_MINOR, SLORMCORE_PATCH, 0
PRODUCTVERSION SLORMCORE_MAJOR, SLORMCORE_MINOR, SLORMCORE_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "SlormCore overlay host"
			VALUE "FileVersion", SLORMCORE_VERSION
			VALUE "ProductName", "SlormCore"
			VALUE "ProductVersion", SLORMCORE_VERSION
			VALUE "OriginalFilename", "SlormCore.dll"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
