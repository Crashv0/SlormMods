#include <winver.h>
#include "source/Version.hpp"

VS_VERSION_INFO VERSIONINFO
FILEVERSION SLORMEXAMPLE_MAJOR, SLORMEXAMPLE_MINOR, SLORMEXAMPLE_PATCH, 0
PRODUCTVERSION SLORMEXAMPLE_MAJOR, SLORMEXAMPLE_MINOR, SLORMEXAMPLE_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "SlormExample"
			VALUE "FileVersion", SLORMEXAMPLE_VERSION
			VALUE "ProductName", "SlormExample"
			VALUE "ProductVersion", SLORMEXAMPLE_VERSION
			VALUE "OriginalFilename", "SlormExample.dll"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
