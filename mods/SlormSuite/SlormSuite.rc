#include <winver.h>
#include "source/Version.hpp"

VS_VERSION_INFO VERSIONINFO
FILEVERSION SLORMSUITE_MAJOR, SLORMSUITE_MINOR, SLORMSUITE_PATCH, 0
PRODUCTVERSION SLORMSUITE_MAJOR, SLORMSUITE_MINOR, SLORMSUITE_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "SlormSuite"
			VALUE "FileVersion", SLORMSUITE_VERSION
			VALUE "ProductName", "SlormSuite"
			VALUE "ProductVersion", SLORMSUITE_VERSION
			VALUE "OriginalFilename", "SlormSuite.dll"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
