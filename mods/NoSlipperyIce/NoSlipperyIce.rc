#include <winver.h>
#include "source/Version.hpp"

VS_VERSION_INFO VERSIONINFO
FILEVERSION NOSLIPPERYICE_MAJOR, NOSLIPPERYICE_MINOR, NOSLIPPERYICE_PATCH, 0
PRODUCTVERSION NOSLIPPERYICE_MAJOR, NOSLIPPERYICE_MINOR, NOSLIPPERYICE_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "NoSlipperyIce"
			VALUE "FileVersion", NOSLIPPERYICE_VERSION
			VALUE "ProductName", "NoSlipperyIce"
			VALUE "ProductVersion", NOSLIPPERYICE_VERSION
			VALUE "OriginalFilename", "NoSlipperyIce.dll"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
