#include <winver.h>
#include "source/Version.hpp"

VS_VERSION_INFO VERSIONINFO
FILEVERSION SLORMHUD_MAJOR, SLORMHUD_MINOR, SLORMHUD_PATCH, 0
PRODUCTVERSION SLORMHUD_MAJOR, SLORMHUD_MINOR, SLORMHUD_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "SlormHUD"
			VALUE "FileVersion", SLORMHUD_VERSION
			VALUE "ProductName", "SlormHUD"
			VALUE "ProductVersion", SLORMHUD_VERSION
			VALUE "OriginalFilename", "SlormHUD.dll"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
